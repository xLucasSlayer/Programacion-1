# Diseño del boton del juego
class Boton:
    """
    Botón rectangular clicable que se dibuja en la pantalla de pygame.

    Atributos:
        rect (pygame.Rect): Área rectangular que ocupa el botón.
        texto (str): Texto que se muestra en el centro del botón.
    """

    def __init__(self, x, y, ancho, alto, texto):
        """
        Crea un botón con su posición, tamaño y texto.

        Parámetros:
            x (int): Coordenada horizontal de la esquina superior izquierda.
            y (int): Coordenada vertical de la esquina superior izquierda.
            ancho (int): Ancho del botón en píxeles.
            alto (int): Alto del botón en píxeles.
            texto (str): Texto que mostrará el botón.

        Valor de retorno:
            None: Es un constructor, solo inicializa el objeto.

        Excepciones:
            TypeError: Si x, y, ancho o alto no son números (lo lanza pygame.Rect).

        Ejemplos:
            >>> boton = Boton(455, 645, 155, 48, "PEDIR CARTA")   # correcto
            >>> boton = Boton("a", 645, 155, 48, "PEDIR CARTA")   # error: TypeError
        """
        self.rect = pygame.Rect(x, y, ancho, alto)
        self.texto = texto

    def dibujar(self, superficie, habilitado=True):
        """
        Dibuja el botón en la superficie indicada.

        Descripción detallada:
            El color cambia según el estado: gris si está deshabilitado,
            dorado claro si el ratón está encima y dorado oscuro en reposo.
            Después dibuja el borde y el texto centrado.

        Parámetros:
            superficie (pygame.Surface): Superficie donde se dibuja el botón.
            habilitado (bool): True si el botón está activo, False si debe
                verse deshabilitado. Por defecto es True.

        Valor de retorno:
            None: Solo dibuja en pantalla.

        Excepciones:
            AttributeError: Si "superficie" no es una superficie válida de pygame.

        Ejemplos:
            >>> BOTON_PEDIR.dibujar(PANTALLA, habilitado=True)   # correcto
            >>> BOTON_PEDIR.dibujar(None)                        # error: AttributeError
        """
        raton = pygame.mouse.get_pos()
        if not habilitado:
            color = (85, 91, 88)
        elif self.rect.collidepoint(raton):
            color = (210, 166, 75)
        else:
            color = (172, 126, 48)

        pygame.draw.rect(superficie, color, self.rect, border_radius=10)
        pygame.draw.rect(superficie, DORADO, self.rect, 2, border_radius=10)
        texto = FUENTE_BOTON.render(self.texto, True, BLANCO)
        superficie.blit(texto, texto.get_rect(center=self.rect.center))

    def fue_presionado(self, posicion):
        """
        Indica si una posición del ratón cae dentro del botón.

        Parámetros:
            posicion (tuple[int, int]): Coordenadas (x, y) del clic.

        Valor de retorno:
            bool: True si la posición está dentro del botón, False si no.

        Excepciones:
            TypeError: Si "posicion" no es una pareja de números.

        Ejemplos:
            >>> BOTON_PEDIR.fue_presionado((500, 660))   # correcto -> True
            >>> BOTON_PEDIR.fue_presionado(500)          # error: TypeError
        """
        return self.rect.collidepoint(posicion)

BOTON_PEDIR = Boton(455, 645, 155, 48, "PEDIR CARTA")
